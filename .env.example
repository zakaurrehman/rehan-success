# ── Rehan Success — web/backend environment ─────────────────────────────────
# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon, Supabase, RDS, local …)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rehan_success?sslmode=require"

# NextAuth — generate with: openssl rand -base64 32
# Also used to sign mobile access tokens (lib/mobile-auth.ts).
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Public URL of this deployment (used for referral links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Canonical marketing domain (metadata, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL="https://www.rehansuccess.com"

# Brand contact + social links (all optional; hidden in the UI when empty)
NEXT_PUBLIC_SUPPORT_EMAIL="support@rehansuccess.com"
NEXT_PUBLIC_SUPPORT_WHATSAPP=""
NEXT_PUBLIC_SOCIAL_INSTAGRAM=""
NEXT_PUBLIC_SOCIAL_TELEGRAM=""
NEXT_PUBLIC_SOCIAL_YOUTUBE=""
NEXT_PUBLIC_SOCIAL_WHATSAPP=""

# App store listings (optional; badges are hidden when empty)
NEXT_PUBLIC_IOS_APP_URL=""
NEXT_PUBLIC_IOS_APP_ID=""
NEXT_PUBLIC_ANDROID_APP_URL=""

# Search Console verification token (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Password for the seeded admin account (prisma/seed.ts). Change after first login.
SEED_ADMIN_PASSWORD="admin123"
