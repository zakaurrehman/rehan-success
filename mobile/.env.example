# Base URL of the Rehan Success Next.js backend (exposes /api/mobile/* and /api/*).
# Android emulator -> http://10.0.2.2:3000
# iOS simulator    -> http://localhost:3000
# Physical device  -> http://<your-LAN-IP>:3000  (or your deployed https URL)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Public website + support contact shown in the app
EXPO_PUBLIC_WEBSITE_URL=https://www.rehansuccess.com
EXPO_PUBLIC_SUPPORT_EMAIL=support@rehansuccess.com

# EAS project id for THIS app (create with `npx eas-cli init`). Leave empty until then.
EAS_PROJECT_ID=

# Optional store identifiers (defaults: com.rehansuccess.app)
IOS_BUNDLE_ID=
ANDROID_PACKAGE=
